{
  "name": "local-cli-desktop",
  "version": "0.13.0",
  "description": "Nova: local AI assistant for projects, sources and memories",
  "author": "Nova Assistant contributors",
  "license": "MIT",
  "homepage": "https://github.com/j-hernandez-dev/nova-assistant",
  "repository": {
    "type": "git",
    "url": "https://github.com/j-hernandez-dev/nova-assistant.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "build:win": "node ./dev/package_windows.cjs",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "build:source": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "test": "node ../ci/run_desktop_contracts.cjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "^5.6.0",
    "vite": "6.4.5",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  },
  "build": {
    "appId": "com.local-cli.desktop",
    "productName": "Nova",
    "copyright": "Copyright (c) 2026 Nova Assistant; original local-cli contributions (c) 2025 lutelute",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../local_cli",
        "to": "local_cli",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../pyproject.toml",
        "to": "pyproject.toml"
      }
    ],
    "icon": "build/icon.png",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Nova-${version}-windows-${arch}-setup.${ext}",
      "extraResources": [
        {
          "from": "../dist/windows-backend/nova-backend",
          "to": "backend"
        },
        {
          "from": "../dist/windows-browser/windows-x64",
          "to": "browser/windows-x64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "j-hernandez-dev",
      "repo": "nova-assistant"
    },
    "directories": {
      "output": "release"
    }
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "esbuild@0.25.12": true
  },
  "contributors": [
    "lutelute (original local-cli project)"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
